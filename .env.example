NODE_ENV=production
HOST=127.0.0.1
PORT=3080
PUBLIC_ORIGIN=https://server.example.invalid
DATA_DIR=/var/lib/ubuntu-control
HELPER_SOCKET=/run/ubuntu-control/helper.sock
PROJECT_ROOT=/srv/ubuntu-projects
# Generate using: openssl rand -hex 32. Keep outside source control.
MASTER_KEY=
# Only for localhost development over HTTP; never enable remotely.
LOCAL_DEV=false

# GitHub App IDs are configured through Settings > GitHub App (no OAuth).
# The dedicated ubuntu-github service alone reads the fixed, existing PEM:
# /etc/ubuntu-control/github/app.pem
# Do not put the private key or installation tokens in this file.
