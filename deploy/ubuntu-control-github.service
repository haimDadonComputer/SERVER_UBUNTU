[Unit]
Description=Ubuntu Control GitHub App credential broker
After=network-online.target
Wants=network-online.target

[Service]
User=ubuntu-github
Group=ubuntu-github
WorkingDirectory=/opt/ubuntu-control
ExecStart=/usr/bin/python3 /opt/ubuntu-control/helper/github_app.py
StateDirectory=ubuntu-control-github
StateDirectoryMode=0700
RuntimeDirectory=ubuntu-control-github
RuntimeDirectoryMode=0700
UMask=0077
LimitCORE=0
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
CapabilityBoundingSet=
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
ReadOnlyPaths=/etc/ubuntu-control/github
InaccessiblePaths=/var/lib/ubuntu-control /var/lib/ubuntu-control-helper /srv/ubuntu-projects /etc/ubuntu-control/app.env /etc/ubuntu-control/helper.json

[Install]
WantedBy=multi-user.target
