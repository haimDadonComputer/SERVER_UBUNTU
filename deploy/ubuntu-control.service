[Unit]
Description=Ubuntu Control web application
After=network.target ubuntu-control-helper.service
Requires=ubuntu-control-helper.service

[Service]
Type=simple
User=ubuntu-control
Group=ubuntu-control
SupplementaryGroups=ubuntu-projects
WorkingDirectory=/opt/ubuntu-control
EnvironmentFile=/etc/ubuntu-control/app.env
ExecStart=/usr/bin/node server/index.mjs
Restart=on-failure
RestartSec=5
UMask=0077
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
CapabilityBoundingSet=
ReadWritePaths=/var/lib/ubuntu-control /srv/ubuntu-projects

[Install]
WantedBy=multi-user.target
